# ===== LLM（OpenAI 兼容：DeepSeek 云端 / vLLM）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# DeepSeek API Key（真实 key 只放 .env，勿提交）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 是否发送 vLLM 专有思考开关 chat_template_kwargs：DeepSeek=false；vLLM/Qwen=true
LLM_THINKING_TOGGLE=false
# 分析类调用给足 token
LLM_MAX_TOKENS=2048
# 抽取用低温，综合建议略高
LLM_TEMPERATURE=0.3
# analyze 超时（秒）与重试次数
LLM_TIMEOUT=120
LLM_RETRIES=2

# ===== Provider =====
# mock | db —— 由 registry 统一分发
PROVIDER_MODE=mock
MOCKDATA_DIR=mockdata

# ===== 达梦 DM8（财务库 GKH）=====
DM_HOST=localhost
DM_PORT=5236
DM_USER=SYSDBA
DM_PASSWORD=your_password_here
DM_SCHEMA=SYSDBA

# ===== 服务 =====
APP_HOST=0.0.0.0
APP_PORT=8000
